rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User document rules
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;

      // Nested user thoughts
      match /thoughts/{thoughtId} {
        allow read, write: if isOwner(userId);
      }

      // Usage & quota counters
      match /usage/{period} {
        allow read: if isOwner(userId);
        allow write: if false; // Server-only via Cloud Functions
      }

      // Entitlements
      match /entitlements/{product} {
        allow read: if isOwner(userId);
        allow write: if false; // RevenueCat webhook / Server-only
      }

      // Devices
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Audit logs (immutable per user)
      match /audit/{auditId} {
        allow read: if isOwner(userId);
        allow write: if false; // Server-only append
      }
    }

    // Processed Webhooks (Server-only deduplication)
    match /processed_events/{eventId} {
      allow read, write: if false;
    }

    // Global audit log (Server-only append)
    match /audit_log/{logId} {
      allow read, write: if false;
    }
  }
}
