# Thought Catcher Backend Configuration
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
APP_CHECK_ENFORCED=false
REVENUECAT_WEBHOOK_SECRET=test_revenuecat_secret

# AI & LLM Gateway
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Storage & Database
DATABASE_URL=sqlite+aiosqlite:///./thought_catcher.db
STORAGE_DIR=./storage/audio

# Quotas
FREE_TIER_DAILY_LIMIT=2
FREE_TIER_WEEKLY_LIMIT=10
